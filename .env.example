# Copy to .env and fill in your own keys. .env is gitignored.
# valuegen needs an OpenAI key (judge/eval) and an Anthropic key (scenario generation).

OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
HF_API_KEY=

# Optional: shared HF cache. Point at a large mount, not home.
# HF_HOME=/path/to/large/disk/hf
